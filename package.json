{
  "name": "pronter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run prepare:assets && tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "npm run prepare:assets && npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outdir=dist-server",
    "start": "cross-env NODE_ENV=production node dist-server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@web-ppt/core": "0.4.5",
    "@web-ppt/viewer-core": "0.4.5",
    "dompurify": "3.4.16",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "libheif-js": "1.23.5",
    "lucide-react": "1.53.0",
    "pdfjs-dist": "6.4.299",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
